{
  "rules": {
    "presence": {
      "$roomId": {
        ".read": "$roomId.matches(/^([1-9][0-9]{0,2}|1000)$/)",
        "$sessionId": {
          ".write": "$roomId.matches(/^([1-9][0-9]{0,2}|1000)$/) && $sessionId.matches(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/)",
          ".validate": "newData.isNumber() && newData.val() <= now"
        }
      }
    }
  }
}
